{
  "name": "print-attest-marketplace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm --workspace apps/api run start:dev",
    "dev:web": "npm --workspace apps/customer-web run dev",
    "db:generate": "npm --workspace apps/api run prisma:generate",
    "db:validate": "npm --workspace apps/api run prisma:validate"
  },
  "engines": {
    "node": ">=20"
  }
}
