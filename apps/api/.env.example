DATABASE_URL=postgresql://postgres:postgres@localhost:5432/print_attest
JWT_SECRET=
# At least 32 bytes. Encrypts pickup codes and delivery PINs; do not rotate while orders are in flight.
DATA_ENCRYPTION_KEY=
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
CUSTOMER_WEB_ORIGIN=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback
STORAGE_DRIVER=local
LOCAL_STORAGE_BASE_URL=http://localhost:3001/api/v1
LOCAL_STORAGE_PATH=
LOCAL_STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
# Optional tuning
MAX_DELIVERY_DISTANCE_KM=50
RATE_LIMIT_PER_MINUTE=240
TRUST_PROXY_HOPS=1
DISABLE_BACKGROUND_JOBS=false
